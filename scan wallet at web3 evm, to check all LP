pragma solidity ^0.8.20;

interface IERC20 {
    function balanceOf(address account)
        external view returns (uint256);

    function decimals() external view returns (uint8);

    function symbol() external view returns (string memory);
}

interface IUniswapV2Pair is IERC20 {
    function token0() external view returns (address);
    function token1() external view returns (address);

    function getReserves()
        external view
        returns (uint112, uint112, uint32);
}

contract EVM_LP_Scanner {

    struct LPInfo {
        address pair;
        address token0;
        address token1;
        uint256 lpBalance;
        uint256 totalSupply;
        uint256 reserve0;
        uint256 reserve1;
        uint256 sharePercent;
    }

    function scanLP(
        address wallet,
        address[] calldata pairs
    ) external view returns (LPInfo[] memory results) {

        results = new LPInfo[](pairs.length);

        for (uint256 i = 0; i < pairs.length; i++) {

            IUniswapV2Pair pair =
                IUniswapV2Pair(pairs[i]);

            uint256 balance =
                pair.balanceOf(wallet);

            uint256 supply =
                pair.totalSupply();

            (uint112 r0, uint112 r1,) =
                pair.getReserves();

            uint256 share = supply > 0
                ? (balance * 10000) / supply
                : 0;

            results[i] = LPInfo({
                pair: pairs[i],
                token0: pair.token0(),
                token1: pair.token1(),
                lpBalance: balance,
                totalSupply: supply,
                reserve0: r0,
                reserve1: r1,
                sharePercent: share
            });
        }
    }
}
